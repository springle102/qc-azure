PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/Qc-WZ
# Keep certificate verification enabled by default. Set false only for a local
# network that replaces Supabase's TLS certificate; the connection remains encrypted.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Docker sets NODE_EXTRA_CA_CERTS to the bundled Supabase CA automatically.
# For Node outside Docker, set this variable before starting Node (not just in .env).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ERROR_SCREENSHOT_BUCKET=error-screenshots
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_QR_BUCKET=qr-codes
SUPABASE_TABLE_TASKS=SeriesList
SUPABASE_TABLE_FREELANCERS=Freelancer
SUPABASE_TABLE_QC=QC
SUPABASE_TABLE_ACCOUNTS=Accounts
SUPABASE_TABLE_DEADLINE_REGISTRATIONS=DeadlineRegistrations
SUPABASE_TABLE_DEADLINES=SeriesList
SUPABASE_TABLE_DIFFICULTY_LEVELS=DifficultyLevels
SUPABASE_TABLE_DIFFICULTY_PRICING=DifficultyPricing
SUPABASE_TABLE_BONUS_SETTINGS=BonusSettings
SUPABASE_TABLE_FIELDS=Fields
SUPABASE_TABLE_GENERAL_SETTINGS=GeneralSettings
SUPABASE_TABLE_ERRORS=Errors
GUIDE_URL=
RESOURCE_URL=

# Google Service Account for private Google Sheet and Drive synchronization.
# Keep the JSON secret outside Git. Use either the inline JSON, base64 JSON, or a local file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Gmail API over HTTPS: works without a custom domain or SMTP.
# Generate OAuth credentials/refresh token with npm run gmail:authorize (see docs/deployment.md).
MAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=your-gmail@gmail.com
GMAIL_SENDER_NAME=WZ System
# Optional legacy provider: set MAIL_PROVIDER=resend to use a verified domain.
RESEND_API_KEY=
RESEND_FROM=
# Public frontend URL for task links in reminder emails. Reminders default to disabled.
APP_PUBLIC_URL=https://qc-manager.pages.dev/

# Device notifications (independent of email). Apply 20261005_web_push.sql first.
# Generate a persistent VAPID key pair with: npm run push:keys
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:your-contact@example.com
