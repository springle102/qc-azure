/><mxPoint x="925" y="670"/></Array></mxGeometry></mxCell><mxCell id="links" value="Mở Guide / Tài nguyên theo mảng" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fillColor=#fff4dd;strokeColor=#a57721;strokeWidth=1.4;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="330" height="72" as="geometry"/></mxCell><mxCell id="a-links" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=12;strokeColor=#64748b;labelBackgroundColor=#ffffff;startArrow=none;endArrow=none;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fl" target="links"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="595"/><mxPoint x="250" y="876"/></Array></mxGeometry></mxCell><mxCell id="notifications" value="Xem thông báo và nhận nhắc hạn" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fillColor=#fff4dd;strokeColor=#a57721;strokeWidth=1.4;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="330" height="72" as="geometry"/></mxCell><mxCell id="a-notifications" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=12;strokeColor=#64748b;labelBackgroundColor=#ffffff;startArrow=none;endArrow=none;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="fl" target="notifications"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="595"/><mxPoint x="250" y="815"/><mxPoint x="925" y="815"/></Array></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Giới hạn quyền Freelancer&lt;/b&gt;&lt;br&gt;Chỉ sửa Status và Feedback của task của mình; Status chỉ được chọn Doing hoặc Submitted. Chỉ cập nhật Fix/Check cho lỗi có &lt;i&gt;editorFreelancerId&lt;/i&gt; trùng hồ sơ của mình. Không tạo task, phân công, duyệt thanh toán hoặc quản lý tài khoản.&lt;br&gt;&lt;br&gt;Đăng ký deadline là đăng ký năng lực nhận chapter theo tuần/tháng; không phải tạo một task deadline mới." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fillColor=#fff4dd;strokeColor=#a57721;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="290" y="1080" width="880" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc-integrations" name="04 · Tích hợp ngoài"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="USE CASE · TÍCH HỢP VÀ TỰ ĐỘNG HÓA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#172b4d;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1500" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Tác nhân bên ngoài hệ thống · Chức năng có điều kiện cấu hình dịch vụ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1500" height="40" as="geometry"/></mxCell><mxCell id="sys" value="HỆ THỐNG QUẢN LÝ DEADLINE WEBTOON" style="swimlane;html=1;startSize=42;horizontal=1;fontFamily=Arial;fontSize=17;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="930" height="1080" as="geometry"/></mxCell><mxCell id="admin" value="Admin" style="shape=umlActor;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#f0eafe;strokeColor=#7051a3;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="95" height="105" as="geometry"/></mxCell><mxCell id="manager" value="Admin / QC" style="shape=umlActor;html=1;verticalLabelPosition=botto