abelBackgroundColor=#ffffff;startArrow=none;endArrow=none;strokeWidth=1.2;" edge="1" parent="1" source="admin" target="sync"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1380"/><mxPoint x="1570" y="1380"/><mxPoint x="1570" y="746"/></Array></mxGeometry></mxCell><mxCell id="history" value="Xem lịch sử gửi email nhắc deadline" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fillColor=#f0eafe;strokeColor=#7051a3;strokeWidth=1.4;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1170" y="855" width="300" height="72" as="geometry"/></mxCell><mxCell id="ad-history" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=12;strokeColor=#64748b;labelBackgroundColor=#ffffff;startArrow=none;endArrow=none;strokeWidth=1.2;" edge="1" parent="1" source="admin" target="history"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1380"/><mxPoint x="1570" y="1380"/><mxPoint x="1570" y="891"/></Array></mxGeometry></mxCell><mxCell id="screenshots" value="Chuyển ảnh lỗi cũ lên Storage" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fillColor=#f0eafe;strokeColor=#7051a3;strokeWidth=1.4;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry x="1170" y="1000" width="300" height="72" as="geometry"/></mxCell><mxCell id="ad-screenshots" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=12;strokeColor=#64748b;labelBackgroundColor=#ffffff;startArrow=none;endArrow=none;strokeWidth=1.2;" edge="1" parent="1" source="admin" target="screenshots"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1380"/><mxPoint x="1570" y="1380"/><mxPoint x="1570" y="1036"/></Array></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Quy tắc thể hiện trên sơ đồ&lt;/b&gt;&lt;br&gt;• Freelancer không được tự tạo tài khoản; Admin cấp tài khoản.&lt;br&gt;• QC thao tác theo quyền/mảng của tài khoản; chức năng xem lương Admin/QC trả toàn bộ dữ liệu lương.&lt;br&gt;• Chỉ Admin gán &lt;i&gt;assignedAdminId&lt;/i&gt; cho task. Phân công Freelancer/QC thuộc chức năng quản lý.&lt;br&gt;• Lương Freelancer tính từ task đã duyệt Thanh toán; lương QC thêm điều kiện trạng thái Done." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fillColor=#f3f5f8;strokeColor=#667085;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="290" y="1400" width="1240" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc-fl" name="03 · Freelancer"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1280" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="USE CASE · FREELANCER" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#172b4d;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1300" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Các thao tác chỉ áp dụng cho task và lỗi được giao cho người đang đăng nhập" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1300" height="40" as="geometry"/></mxCell><mxCell id="sys" value="HỆ THỐNG QUẢN LÝ DEADLINE WEBTOON" style="swimlane;html=1;startSize=42;horizontal=1;fontFamily=Arial;fontSize=17;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="880" height="880" as="geometry"/></mxCell><mxCell id="fl" value="Freelancer" style="shape=umlActor;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#fff4dd;str