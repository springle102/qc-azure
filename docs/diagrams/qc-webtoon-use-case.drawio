Storage." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fillColor=#f3f5f8;strokeColor=#667085;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="1290" width="930" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>