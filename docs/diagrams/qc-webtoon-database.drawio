0" y="925"/><mxPoint x="1100" y="1530"/><mxPoint x="490" y="1530"/><mxPoint x="490" y="1380"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;FK VÀ LIÊN KẾT LOGIC&lt;/b&gt;&lt;br&gt;WebPushDeliveries.subscriptionId là FK duy nhất trong 4 bảng hạ tầng. Các accountId/seriesId/freelancerId kiểu text là snapshot hoặc liên kết ứng dụng; không phải FK.&lt;br&gt;&lt;br&gt;&lt;b&gt;Khóa chính ghép&lt;/b&gt;&lt;br&gt;WebPushNotificationState: (accountId, role, eventId).&lt;br&gt;&lt;br&gt;&lt;b&gt;Chống trùng email&lt;/b&gt;&lt;br&gt;UNIQUE (seriesId, chapterNumber, freelancerId, dueAt, milestone).&lt;br&gt;milestone: 24h / 6h / 3h / overdue.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thông báo&lt;/b&gt;&lt;br&gt;subscription là JSON của đăng ký thiết bị. Bảng trạng thái lưu fingerprint/version để nhận diện thay đổi sự kiện. Bảng delivery lưu lần gửi và lease/retry." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fillColor=#f3f5f8;strokeColor=#667085;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="610" y="1050" width="420" height="450" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;Xanh liền: FK thực tế · Vàng đứt: ứng dụng.&lt;br&gt;PK: khóa chính · ?: cho phép NULL.&lt;br&gt;Chân quạ: 0..n · vạch: 1 · tròn + vạch: 0..1.&lt;br&gt;Các bảng hạ tầng bật RLS; backend vận hành worker." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fillColor=#f3f5f8;strokeColor=#667085;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="65" y="690" width="395" height="195" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>