{
  "name": "qc-manager",
  "version": "1.0.0",
  "description": "Hệ thống quản lý QC Webtoon chuyên nghiệp cho WZ System (React + Node.js)",
  "scripts": {
    "gmail:authorize": "node scripts/gmail-authorize.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "cd apps/client && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "build:client": "cd apps/client && npm run build",
    "test": "node --test apps/client/tests/*.test.mjs apps/server/tests/*.test.mjs",
    "lint": "node apps/client/node_modules/oxlint/bin/oxlint apps scripts",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "node scripts/docker.mjs down",
    "docker:logs": "node scripts/docker.mjs logs",
    "docker:status": "node scripts/docker.mjs status"
  },
  "keywords": ["webtoon", "qc", "wzsystem", "react", "nodejs"],
  "author": "WZ System",
  "license": "ISC"
}
